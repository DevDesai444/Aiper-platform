# Frontend configuration example. Copy to frontend/.env.local (gitignored) for
# local dev, or pass these as build args in docker-compose.
#
# IMPORTANT: this is a Next.js app, so browser-exposed vars use the NEXT_PUBLIC_
# prefix (NOT VITE_) and are inlined at BUILD time — rebuild after changing them.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase identity (production auth) ─────────────────────────────────────
# When BOTH are set, the frontend authenticates via supabase-js (sign-up /
# sign-in / session refresh) and sends the Supabase access token as the Bearer
# token on every API call — the backend verifies it (see backend/.env.example:
# SUPABASE_URL / SUPABASE_JWT_SECRET). When either is empty, the app falls back
# to the legacy self-issued login form, unchanged.
#
# The anon key is a public, publishable key — safe to ship in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
