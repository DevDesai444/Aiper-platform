# Backend configuration example. Copy to backend/.env and fill in.
# Every key maps to a field in app/config.py (Settings). Real secrets never
# belong in version control — .env is gitignored.

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=aiper

# ── Database ──────────────────────────────────────────────────────────────
# Async SQLAlchemy DSN. Use host "postgres" under docker-compose, "localhost"
# when running the backend directly against a local Postgres.
DATABASE_URL=postgresql+asyncpg://aiper_user:aiper_password@postgres:5432/aiper_db

# ── Authentication ────────────────────────────────────────────────────────
# Two modes. Production uses Supabase; dev/demo may use the legacy login.
# Startup FAILS CLOSED if neither mode is configured (no Supabase and legacy off).
#
# Production (Supabase / GoTrue) — the backend verifies client-supplied Supabase
# JWTs and never issues its own tokens or handles passwords:
#   SUPABASE_URL         Project URL. The issuer is {SUPABASE_URL}/auth/v1 and,
#                        when SUPABASE_JWKS_URL is empty, the JWKS endpoint is
#                        derived as {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
#   SUPABASE_JWT_SECRET  HS256 shared secret. Optional — set it to accept HS256
#                        tokens (and to run the hermetic test suite). Leave empty
#                        for asymmetric-only (RS256/ES256) verification via JWKS.
#   SUPABASE_JWKS_URL    Override the derived JWKS URL only for custom setups.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Legacy self-issued bcrypt + HS256 login (register/login endpoints). Dev/demo
# ONLY. When Supabase is configured it takes precedence and legacy tokens are
# rejected. Set to 1/true to enable; endpoints return 404 while disabled.
AUTH_LEGACY_LOGIN_ENABLED=0

# Secret used to sign/verify legacy self-issued tokens. Change for any shared env.
JWT_SECRET=super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Azure OpenAI ──────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# ── Vector store (Qdrant) ─────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=aiper_pages
EMBEDDING_DIM=3072

# ── Storage & CORS ────────────────────────────────────────────────────────
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=40
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Ingestion safety ──────────────────────────────────────────────────────
# Parsing runs in a killable child process. Deadline is wall-clock seconds;
# the memory ceiling applies where the OS supports RLIMIT_AS (Linux).
PARSE_TIMEOUT_SECONDS=120
PARSE_MEMORY_MB=1024
PARSE_CONCURRENCY=2
# A file may index at most this many pages (slides count as pages).
MAX_PAGES_PER_FILE=800
# Uploads per user inside the sliding window.
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_SECONDS=60
